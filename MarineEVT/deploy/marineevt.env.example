# Copy to ~/xcx/configs/marineevt.env and adjust absolute paths.
PROJECT_ROOT="${HOME}/xcx/exp_3/MarineEVT"
MODEL_ROOT="${HOME}/xcx/models"
DATA_ROOT="${HOME}/xcx/data"
LOG_ROOT="${HOME}/xcx/logs"
RUN_ROOT="${HOME}/xcx/run"

# Persistent Qwen3-VL service on physical GPU 0.
QWEN_MODEL_PATH="${MODEL_ROOT}/Qwen3-VL-8B-Instruct"
QWEN_ALLOWED_DATA_ROOT="${DATA_ROOT}"
QWEN_GPU_ID="0"
QWEN_DEVICE="cuda:0"
QWEN_DTYPE="float16"
QWEN_MIN_PIXELS="100352"
QWEN_MAX_PIXELS="200704"
QWEN_MAX_NEW_TOKENS="512"
QWEN_BIND_HOST="127.0.0.1"
QWEN_PORT="8100"

# Download with: bash scripts/download_sam3_gitcode.sh "${MODEL_ROOT}/sam3"
SAM3_CHECKPOINT_PATH="${MODEL_ROOT}/sam3/sam3.pt"
SAM3_BPE_PATH="${PROJECT_ROOT}/evt_r1/tools/sam3/assets/bpe_simple_vocab_16e6.txt.gz"
SAM3_ALLOWED_DATA_ROOT="${DATA_ROOT}"
SAM3_DEVICE="cuda"
SAM3_BASE_CONFIDENCE="0.05"

SAM3_BASE_PORT="8111"
SAM3_NUM_GPUS="8"
# Reserve physical GPU 0 for Qwen3-VL and use all remaining GPUs for SAM3.
SAM3_GPU_IDS="1,2,3,4,5,6,7"
SAM3_BIND_HOST="127.0.0.1"
